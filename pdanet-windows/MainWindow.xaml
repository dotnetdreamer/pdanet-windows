<Window x:Class="PdaNetPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDANET WINDOWS" Height="620" Width="900" MinHeight="500" MinWidth="760"
        Background="{StaticResource B_Black}" WindowStartupLocation="CenterScreen">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0" BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Padding="10,8" Margin="5,5,5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x25C8;" Foreground="{StaticResource B_BorderGray}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="  PDANET WINDOWS" FontWeight="Bold" FontSize="14"
                           Foreground="{StaticResource B_TextWhite}" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderStatus" Grid.Column="2" Text="[DISCONNECTED]" FontWeight="Bold"
                           Foreground="{StaticResource B_TextGray}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock x:Name="HeaderClock" Grid.Column="3" Text="--:--:--"
                           Foreground="{StaticResource B_TextGray}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ CONTENT 2x2 ============ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- (0,0) CONNECTION STATUS -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="CONNECTION STATUS" Style="{StaticResource PanelHeader}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="STATUS" Style="{StaticResource MetricLabel}" Margin="0,3" />
                        <TextBlock x:Name="StatusValue" Grid.Row="0" Grid.Column="1" Text="&#x25CF; INACTIVE" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_Red}" Margin="0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="INTERFACE" Style="{StaticResource MetricLabel}" Margin="0,3" />
                        <TextBlock x:Name="InterfaceValue" Grid.Row="1" Grid.Column="1" Text="NOT DETECTED" Style="{StaticResource MetricValue}" Margin="0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ENDPOINT" Style="{StaticResource MetricLabel}" Margin="0,3" />
                        <TextBlock x:Name="EndpointValue" Grid.Row="2" Grid.Column="1" Text="192.168.49.1:8000" Style="{StaticResource MetricValue}" Margin="0,3" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="UPTIME" Style="{StaticResource MetricLabel}" Margin="0,3" />
                        <TextBlock x:Name="UptimeValue" Grid.Row="3" Grid.Column="1" Text="00:00:00" Style="{StaticResource MetricValue}" Margin="0,3" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="STEALTH" Style="{StaticResource MetricLabel}" Margin="0,3" />
                        <TextBlock x:Name="StealthValue" Grid.Row="4" Grid.Column="1" Text="DISABLED" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_TextGray}" Margin="0,3" />
                    </Grid>

                    <Separator Background="{StaticResource B_BorderGray}" Margin="0,8" />
                    <TextBlock Text="CONNECTION QUALITY" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="QualityValue" Text="&#x25CF; UNKNOWN" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_TextGray}" Margin="0,2" />
                    <ProgressBar x:Name="QualityBar" Height="10" Minimum="0" Maximum="100" Value="0"
                                 Background="{StaticResource B_DarkGray}" Foreground="{StaticResource B_GreenDark}"
                                 BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- (0,1) NETWORK METRICS / DATA USAGE -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <TabControl x:Name="MetricsTabs" Background="{StaticResource B_Black}" BorderThickness="0">
                        <TabItem Header="METRICS">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x2193; DOWN" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="DownValue" Grid.Row="0" Grid.Column="1" Text="0.0 KB/s" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_GreenDim}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x2191; UP" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="UpValue" Grid.Row="1" Grid.Column="1" Text="0.0 KB/s" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="LATENCY" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="LatencyValue" Grid.Row="2" Grid.Column="1" Text="-- ms" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="LOSS" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="LossValue" Grid.Row="3" Grid.Column="1" Text="-- %" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="TotalValue" Grid.Row="4" Grid.Column="1" Text="&#x2193; 0 B  &#x2191; 0 B" Style="{StaticResource MetricValue}" Margin="0,3" />
                                </Grid>
                                <TextBlock Text="BANDWIDTH" Style="{StaticResource MetricLabel}" Margin="0,8,0,2" />
                                <Border BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Height="70" Background="{StaticResource B_Black}">
                                    <Canvas x:Name="BandwidthCanvas" ClipToBounds="True">
                                        <Polyline x:Name="DownLine" Stroke="{StaticResource B_GreenDim}" StrokeThickness="1" />
                                        <Polyline x:Name="UpLine" Stroke="{StaticResource B_Orange}" StrokeThickness="1" />
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="DATA USAGE">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SESSION DOWNLOAD" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="SessionDown" Grid.Row="0" Grid.Column="1" Text="0 B" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SESSION UPLOAD" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="SessionUp" Grid.Row="1" Grid.Column="1" Text="0 B" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SESSION TOTAL" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="SessionTotal" Grid.Row="2" Grid.Column="1" Text="0 B" Style="{StaticResource MetricValue}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="WARNING AT" Style="{StaticResource MetricLabel}" Margin="0,3" />
                                    <TextBlock x:Name="WarningValue" Grid.Row="3" Grid.Column="1" Text="10240 MB" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_Yellow}" Margin="0,3" />
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- (1,0) SYSTEM LOG -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SYSTEM LOG" Style="{StaticResource PanelHeader}" />
                    <Grid DockPanel.Dock="Top" Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LogSearch" Grid.Column="0" Height="24" TextChanged="OnLogSearchChanged" />
                        <ToggleButton x:Name="FilterErrors" Grid.Column="1" Content="ERRORS" Width="64" Height="24"
                                      Margin="4,0,0,0" Style="{StaticResource SwitchToggle}" Click="OnLogFilterChanged" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="COPY" Click="OnCopyLogs" Margin="0,0,4,0" />
                        <Button Content="EXPORT" Click="OnExportLogs" Margin="0,0,4,0" />
                        <Button Content="CLEAR" Click="OnClearLogs" />
                    </StackPanel>
                    <ListBox x:Name="LogList" Background="{StaticResource B_Black}" BorderBrush="{StaticResource B_BorderGray}"
                             BorderThickness="1" Foreground="{StaticResource B_TextGray}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           TextWrapping="NoWrap" Foreground="{StaticResource B_TextGray}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="OK">
                                                    <Setter Property="Foreground" Value="{StaticResource B_GreenDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                    <Setter Property="Foreground" Value="{StaticResource B_Orange}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                    <Setter Property="Foreground" Value="{StaticResource B_RedDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="CRITICAL">
                                                    <Setter Property="Foreground" Value="{StaticResource B_Red}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- (1,1) OPERATIONS -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="OPERATIONS" Style="{StaticResource PanelHeader}" />

                    <TextBlock Text="CONNECTION MODE" Style="{StaticResource MetricLabel}" Margin="0,4,0,2" />
                    <ComboBox x:Name="ModeCombo" SelectedIndex="1">
                        <ComboBoxItem Content="USB TETHER" />
                        <ComboBoxItem Content="WIFI HOTSPOT" />
                        <ComboBoxItem Content="IPHONE HOTSPOT" />
                        <ComboBoxItem Content="ADB AGENT (VPN)" />
                    </ComboBox>

                    <TextBlock Text="SAVED PROFILES" Style="{StaticResource MetricLabel}" Margin="0,8,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfilesCombo" Grid.Column="0" SelectionChanged="OnProfileSelected" />
                        <Button Grid.Column="1" Content="&#x21BB;" Width="30" Margin="4,0,0,0" Click="OnRefreshProfiles" ToolTip="Reload profiles" />
                    </Grid>

                    <Button x:Name="ConnectBtn" Content="&#x25B6; CONNECT" Style="{StaticResource ConnectButton}"
                            Height="36" Margin="0,10,0,4" Click="OnConnectClicked" />
                    <Button x:Name="DisconnectBtn" Content="&#x25A0; DISCONNECT" Style="{StaticResource DisconnectButton}"
                            Height="36" Margin="0,0,0,4" IsEnabled="False" Click="OnDisconnectClicked" />

                    <Separator Background="{StaticResource B_BorderGray}" Margin="0,6" />

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STEALTH MODE" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StealthStatus" Grid.Column="1" Text="[AUTO]" Style="{StaticResource MetricValue}" Foreground="{StaticResource B_GreenDim}" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="AUTO-RECONNECT" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="AutoReconnectSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="OnAutoReconnectToggled" />
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="START ON BOOT" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource SwitchToggle}" Click="OnAutostartToggled" />
                    </Grid>

                    <Separator Background="{StaticResource B_BorderGray}" Margin="0,6" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="HISTORY" Click="OnHistoryClicked" Margin="0,0,4,0" />
                        <Button Content="SPEED TEST" Click="OnSpeedTestClicked" Margin="0,0,4,0" />
                        <Button Content="SETTINGS" Click="OnSettingsClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" Background="{StaticResource B_DarkGray}" BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Padding="8,4" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SbStatus" Grid.Column="0" Text="SYS: INACTIVE" FontSize="10" Foreground="{StaticResource B_TextGray}" />
                <TextBlock x:Name="SbNetwork" Grid.Column="1" Text="NET: 0.0 MB/s" FontSize="10" Foreground="{StaticResource B_TextGray}" />
                <TextBlock x:Name="SbStealth" Grid.Column="2" Text="STEALTH: OFF" FontSize="10" Foreground="{StaticResource B_TextGray}" />
                <TextBlock x:Name="SbUptime" Grid.Column="3" Text="UPTIME: 00:00:00" FontSize="10" Foreground="{StaticResource B_TextGray}" />
            </Grid>
        </Border>
    </Grid>
</Window>
