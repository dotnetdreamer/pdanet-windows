<Window x:Class="PdaNetPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PdaNetPortable.Views"
        Title="PdaNet Windows" Width="1120" Height="760" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource B.Bg0}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Resources/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource B.Line2}" BorderThickness="1">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Ambient layers: dot grid and a soft glow that follows the connection state -->
            <Rectangle Grid.RowSpan="3" Fill="{StaticResource B.DotGrid}" IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.7,0.32" GradientOrigin="0.7,0.32" RadiusX="0.55" RadiusY="0.6">
                        <GradientStop x:Name="AmbientStop" Color="#0C2BF5A8" Offset="0" />
                        <GradientStop Color="#002BF5A8" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ============================ Title bar ============================ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="8" Background="{StaticResource B.AccentSoft}" BorderBrush="{StaticResource B.AccentLine}" BorderThickness="1" />
                        <TextBlock Text="&#xE704;" FontFamily="{StaticResource F.Icon}" FontSize="15" Foreground="{StaticResource B.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="PdaNet" FontFamily="{StaticResource F.Display}" FontSize="15" FontWeight="SemiBold"
                               Margin="11,0,0,1" VerticalAlignment="Center" />
                    <TextBlock Text="windows" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Text3}"
                               Margin="7,1,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="_" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Accent}"
                               Margin="1,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Border x:Name="StatusPill" Grid.Column="2" CornerRadius="14" Padding="12,5,14,5" Margin="0,0,14,0"
                        VerticalAlignment="Center" BorderThickness="1"
                        Background="{StaticResource B.Bg2}" BorderBrush="{StaticResource B.Line2}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{StaticResource B.Text3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PillText" Text="Offline" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="PillTime" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Text2}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaxBtn" Style="{StaticResource Btn.Chrome}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize" />
                    <Button Style="{StaticResource Btn.ChromeClose}" Content="&#xE8BB;" Click="OnCloseClick"
                            ToolTip="Close to the tray, PdaNet keeps running" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Close to tray" />
                </StackPanel>
            </Grid>

            <!-- ============================== Body =============================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,1,0" Background="#99060809">
                    <DockPanel Margin="0,12,0,14">
                        <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" FontFamily="{StaticResource F.Mono}" FontSize="10.5"
                                   Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" />
                        <StackPanel>
                            <RadioButton x:Name="NavConnect" Style="{StaticResource NavItem}" Tag="&#xE7E8;" Content="Connect"
                                         IsChecked="True" Click="OnNav" ToolTip="Connect  (Ctrl+1)" />
                            <RadioButton x:Name="NavActivity" Style="{StaticResource NavItem}" Tag="&#xE756;" Content="Activity"
                                         Click="OnNav" ToolTip="Activity  (Ctrl+2)" />
                            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="History"
                                         Click="OnNav" ToolTip="History  (Ctrl+3)" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                         Click="OnNav" ToolTip="Settings  (Ctrl+4)" />
                            <RadioButton x:Name="NavHelp" Style="{StaticResource NavItem}" Tag="&#xE9CE;" Content="Help"
                                         Click="OnNav" ToolTip="Help  (F1)" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="PageHost" Grid.Column="1">
                    <v:ConnectView x:Name="ConnectPage" />
                    <v:ActivityView x:Name="ActivityPage" Visibility="Collapsed" />
                    <v:HistoryView x:Name="HistoryPage" Visibility="Collapsed" />
                    <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                    <v:HelpView x:Name="HelpPage" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- =========================== Status strip ========================== -->
            <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Background="#CC040608">
                <Grid Margin="16,0" TextElement.FontFamily="{StaticResource F.Mono}" TextElement.FontSize="11"
                      TextElement.Foreground="{StaticResource B.Text3}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SbDot" Width="6" Height="6" Fill="{StaticResource B.Text3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SbState" Text="OFFLINE" Margin="8,0,0,0" />
                        <TextBlock Text="&#x2502;" Margin="12,0" Foreground="{StaticResource B.Line2}" />
                        <TextBlock x:Name="SbMode" Text="PHONE VPN" />
                        <TextBlock Text="&#x2502;" Margin="12,0" Foreground="{StaticResource B.Line2}" />
                        <TextBlock Text="&#x2193;" Foreground="{StaticResource B.Accent}" />
                        <TextBlock x:Name="SbDown" Text="0 B/s" Margin="5,0,0,0" />
                        <TextBlock Text="&#x2191;" Foreground="{StaticResource B.Cyan}" Margin="12,0,0,0" />
                        <TextBlock x:Name="SbUp" Text="0 B/s" Margin="5,0,0,0" />
                        <TextBlock Text="&#x2502;" Margin="12,0" Foreground="{StaticResource B.Line2}" />
                        <TextBlock x:Name="SbStealth" Text="STEALTH IDLE"
                                   ToolTip="Stealth hides that this PC is sharing your phone's internet" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="SbData" Text="DATA 0 B" />
                        <TextBlock Text="&#x2502;" Margin="12,0" Foreground="{StaticResource B.Line2}" />
                        <TextBlock x:Name="SbClock" Text="00:00:00" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= Sheets (in window dialogs) ===================== -->
            <Grid x:Name="OverlayHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
                <Rectangle Fill="{StaticResource B.Scrim}" MouseLeftButtonDown="OnScrimClick" />
                <ContentControl x:Name="OverlaySlot" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
            </Grid>

            <!-- =============================== Toasts ============================= -->
            <StackPanel x:Name="ToastHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,18,0" Width="340" />
        </Grid>
    </Border>
</Window>
