<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PdaNetPortable</AssemblyName>
    <RootNamespace>PdaNetPortable</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <StartupObject>PdaNetPortable.Program</StartupObject>
    <NoWarn>WFO0003</NoWarn>
    <!-- Screen sharing converts pixels with pointers, row by row -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>PdaNet Windows (Portable)</AssemblyTitle>
    <Product>PdaNet Windows Portable</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- The phone-side agent (ProxyMain.java compiled to dex), embedded for one-click deploy -->
    <EmbeddedResource Include="Resources\proxy.dex">
      <LogicalName>PdaNetPortable.proxy.dex</LogicalName>
    </EmbeddedResource>
    <!-- In-page helper for the MCP browser tools (accessibility snapshot + element resolver) -->
    <EmbeddedResource Include="Mcp\snapshot.js">
      <LogicalName>PdaNetPortable.snapshot.js</LogicalName>
    </EmbeddedResource>
    <!-- Bundled Google platform-tools adb (portable: no separate adb install needed) -->
    <EmbeddedResource Include="Resources\adb\adb.exe">
      <LogicalName>PdaNetPortable.adb.adb.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\adb\AdbWinApi.dll">
      <LogicalName>PdaNetPortable.adb.AdbWinApi.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\adb\AdbWinUsbApi.dll">
      <LogicalName>PdaNetPortable.adb.AdbWinUsbApi.dll</LogicalName>
    </EmbeddedResource>
    <!-- The WebRTC side of screen sharing (rtc/, Go and Pion), unpacked to the data folder when a
         session starts. Built from rtc/ by BuildRtcHelper below, never kept in git -->
    <EmbeddedResource Include="Resources\rtc\pdanet-rtc.exe">
      <LogicalName>PdaNetPortable.rtc.pdanet-rtc.exe</LogicalName>
    </EmbeddedResource>
    <!-- Window icon, loaded at runtime via the Icon="Resources/app.ico" pack URI -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PdaNet browser on the Launchpad, it runs on the Microsoft Edge WebView2 Runtime that ships with Windows -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Screen sharing: Desktop Duplication to capture the screen, Media Foundation for H.264 on the GPU -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <!-- Portable single-file self-contained publish defaults -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Screen sharing's helper is built from the Go code in rtc/ before the app, when that code is
       newer than the helper, so the helper is never kept in git. Needs Go 1.26 or newer on PATH;
       the Go libraries come from the Go module proxy on the first build -->
  <PropertyGroup>
    <RtcDir>$(MSBuildThisFileDirectory)..\rtc\</RtcDir>
    <RtcExe>$(MSBuildThisFileDirectory)Resources\rtc\pdanet-rtc.exe</RtcExe>
  </PropertyGroup>
  <ItemGroup>
    <RtcSource Include="$(RtcDir)*.go;$(RtcDir)go.mod;$(RtcDir)go.sum" Exclude="$(RtcDir)*_test.go" />
  </ItemGroup>
  <!-- -p:SkipRtcHelper=true keeps the helper already in Resources\rtc, for app-only builds while
       the Go code is being changed. -->
  <Target Name="BuildRtcHelper" BeforeTargets="BeforeBuild" Inputs="@(RtcSource)" Outputs="$(RtcExe)"
          Condition="'$(SkipRtcHelper)' != 'true' Or !Exists('$(RtcExe)')">
    <Exec Command="go version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GoVersionExit" />
    </Exec>
    <Error Condition="'$(GoVersionExit)' != '0'"
           Text="Screen sharing's helper is built from the rtc folder with Go. Install Go 1.26 or newer from https://go.dev/dl/, open a new window and build again" />
    <MakeDir Directories="$(MSBuildThisFileDirectory)Resources\rtc" />
    <Exec Command="go build -trimpath -buildvcs=false -ldflags &quot;-s -w&quot; -o &quot;$(RtcExe)&quot; ."
          WorkingDirectory="$(RtcDir)" EnvironmentVariables="CGO_ENABLED=0;GOOS=windows;GOARCH=amd64" />
  </Target>

</Project>
