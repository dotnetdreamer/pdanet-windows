<Window x:Class="PdaNetPortable.Dialogs.SpeedTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPEED TEST" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B_Black}">
    <Border BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Margin="6">
        <StackPanel Margin="16">
            <TextBlock Text="DOWNLOAD SPEED TEST" Style="{StaticResource PanelHeader}" />
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource B_TextGray}" Margin="0,6,0,8" />
            <TextBlock x:Name="ResultText" Text="-- Mbps" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource B_Green}" HorizontalAlignment="Center" Margin="0,6" />
            <ProgressBar x:Name="Progress" Height="12" IsIndeterminate="False" Minimum="0" Maximum="100"
                         Background="{StaticResource B_DarkGray}" Foreground="{StaticResource B_GreenDark}"
                         BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Margin="0,4,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartBtn" Content="START" Style="{StaticResource ConnectButton}" Width="90" Height="30" Click="OnStart" Margin="0,0,8,0" />
                <Button Content="CLOSE" Width="90" Height="30" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
