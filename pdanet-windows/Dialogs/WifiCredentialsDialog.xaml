<Window x:Class="PdaNetPortable.Dialogs.WifiCredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIFI CONNECTION" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource B_Black}">
    <Border BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Margin="6">
        <StackPanel Margin="14">
            <TextBlock x:Name="InfoText" Text="Connect to Android/iPhone hotspot" Foreground="{StaticResource B_TextGray}" Margin="0,0,0,10" TextWrapping="Wrap" />

            <TextBlock Text="NETWORK NAME (SSID)" Style="{StaticResource MetricLabel}" Margin="0,0,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SsidCombo" Grid.Column="0" IsEditable="True" />
                <Button x:Name="ScanBtn" Grid.Column="1" Content="SCAN" Width="64" Margin="6,0,0,0" Click="OnScan" />
            </Grid>

            <TextBlock Text="PASSWORD" Style="{StaticResource MetricLabel}" Margin="0,10,0,2" />
            <PasswordBox x:Name="PwdBox" />

            <TextBlock x:Name="ScanStatus" Text="" Foreground="{StaticResource B_Orange}" FontSize="10" Margin="0,8,0,0" Height="16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="CONNECT" Style="{StaticResource ConnectButton}" Width="100" Height="32" Click="OnConnect" Margin="0,0,8,0" />
                <Button Content="CANCEL" Width="90" Height="32" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
