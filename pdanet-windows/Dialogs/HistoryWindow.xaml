<Window x:Class="PdaNetPortable.Dialogs.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CONNECTION HISTORY" Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B_Black}">
    <Border BorderBrush="{StaticResource B_BorderGray}" BorderThickness="1" Margin="6">
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="CONNECTION HISTORY" Style="{StaticResource PanelHeader}" />
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Text="" Foreground="{StaticResource B_Green}" Margin="0,2,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="CLEAR HISTORY" Style="{StaticResource DisconnectButton}" Width="130" Height="30" Click="OnClear" Margin="0,0,8,0" />
                <Button Content="CLOSE" Width="90" Height="30" Click="OnClose" />
            </StackPanel>
            <ListBox x:Name="HistoryList" Background="{StaticResource B_Black}" BorderBrush="{StaticResource B_BorderGray}"
                     BorderThickness="1" Foreground="{StaticResource B_TextGray}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
        </DockPanel>
    </Border>
</Window>
