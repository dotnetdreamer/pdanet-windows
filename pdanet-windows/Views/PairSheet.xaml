<UserControl x:Class="PdaNetPortable.Views.PairSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="480">
    <Border Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock Text="&#xE701;" Style="{StaticResource T.Icon}" FontSize="18"
                                   Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Title" Text="Pair over WiFi" Style="{StaticResource T.H2}" FontSize="17" />
                        <TextBlock x:Name="Subtitle" Text="Only once, after pairing PdaNet can usually find the phone"
                                   Style="{StaticResource T.Small}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancel" ToolTip="Close" AutomationProperties.Name="Close" />
            </Grid>

            <ItemsControl x:Name="Steps" ItemTemplate="{StaticResource Tpl.Numbered}" Focusable="False" Margin="0,22,0,6" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CodeCol" Width="132" />
                    <ColumnDefinition x:Name="GapCol" Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CodePanel">
                    <TextBlock Text="PAIRING CODE" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,6" />
                    <TextBox x:Name="Code" MaxLength="7" FontFamily="{StaticResource F.Mono}" FontSize="15" Tag="6 digits"
                             AutomationProperties.Name="Pairing code" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="AddressLabel" Text="IP ADDRESS AND PORT" Style="{StaticResource T.Eyebrow}" Margin="0,0,0,6" />
                    <TextBox x:Name="Address" FontFamily="{StaticResource F.Mono}" FontSize="13.5" Tag="Like 192.168.1.20:37845"
                             AutomationProperties.Name="IP address and port" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0" MinHeight="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="13" Height="13" Margin="0,2,9,0" VerticalAlignment="Top">
                    <Path x:Name="Spinner" Stroke="{StaticResource B.Accent}" StrokeThickness="2" StrokeStartLineCap="Round"
                          Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" />
                        </Path.RenderTransform>
                    </Path>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource T.Small}" TextWrapping="Wrap" />
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SwitchBtn" Style="{StaticResource Btn.Link}" Content="Paired before? Link with the address"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Click="OnSwitch" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Ghost}" Content="Cancel" Click="OnCancel" />
                    <Button x:Name="GoBtn" Style="{StaticResource Btn.Primary}" Tag="&#xE71B;" Content="Pair" Margin="8,0,0,0"
                            Click="OnGo" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
