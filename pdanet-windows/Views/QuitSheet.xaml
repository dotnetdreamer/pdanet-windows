<UserControl x:Class="PdaNetPortable.Views.QuitSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="470">
    <Border Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource T.Icon}" FontSize="18" Foreground="{StaticResource B.Accent}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Close PdaNet?" Style="{StaticResource T.H2}" FontSize="17" />
                        <TextBlock Text="Keep it running in the tray, or quit it" Style="{StaticResource T.Small}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancel" ToolTip="Close" AutomationProperties.Name="Close" />
            </Grid>

            <TextBlock Style="{StaticResource T.Body}" Margin="0,20,0,0"
                       Text="In the tray by the clock PdaNet keeps working, your connection, screen share and easy access go on. Quit closes PdaNet completely" />

            <!-- What quitting ends right now -->
            <Border x:Name="LossBox" Background="{StaticResource B.AmberSoft}" BorderBrush="{StaticResource B.AmberLine}" BorderThickness="1"
                    CornerRadius="9" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Amber}"
                               VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="LossText" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text}" Margin="10,0,0,0" />
                </DockPanel>
            </Border>

            <DockPanel Margin="0,18,0,0">
                <ToggleButton x:Name="Remember" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              AutomationProperties.Name="Do not ask again" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Do not ask again" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text2}" />
                    <TextBlock Text="Your pick stays, change it in Settings, App and Windows" Style="{StaticResource T.Small}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,24,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="Cancel" Click="OnCancel" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="QuitBtn" Style="{StaticResource Btn.Danger}" Tag="&#xE7E8;" Content="Quit" Click="OnQuit" />
                    <Button x:Name="TrayBtn" Style="{StaticResource Btn.Primary}" Content="Keep in tray" Margin="8,0,0,0"
                            IsDefault="True" Click="OnTray" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
