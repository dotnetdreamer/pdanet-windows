<UserControl x:Class="PdaNetPortable.Views.RequestSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680">
    <UserControl.Resources>
        <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Eyebrow}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeadBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Terminal}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="HeadText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <!-- Who and where -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Border CornerRadius="11" Background="{StaticResource B.Bg3}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" />
                    <Image x:Name="AppIcon" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="AppMono" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <DockPanel>
                        <Border x:Name="BadgeBox" DockPanel.Dock="Left" CornerRadius="4" Padding="5,1,5,2" VerticalAlignment="Center">
                            <TextBlock x:Name="BadgeText" FontFamily="{StaticResource F.Mono}" FontSize="10.5" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="HostText" Style="{StaticResource T.H2}" FontSize="17" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="SubText" Style="{StaticResource T.Small}" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" VerticalAlignment="Top"
                        Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close" />
            </Grid>

            <Border Style="{StaticResource HeadBox}" Padding="12,9" Margin="0,18,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Copy web address" Click="OnCopyUrl"
                            VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock x:Name="UrlText" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Text}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- The numbers -->
            <Grid Margin="2,16,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="RESULT" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="ResultValue" Style="{StaticResource FactValue}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="TOOK" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="TookValue" Style="{StaticResource FactValue}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FactLabel}"><Run Text="&#x2191; " Foreground="{StaticResource B.Cyan}" /><Run Text="SENT" /></TextBlock>
                    <TextBlock x:Name="SentValue" Style="{StaticResource FactValue}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FactLabel}"><Run Text="&#x2193; " Foreground="{StaticResource B.Accent}" /><Run Text="RECEIVED" /></TextBlock>
                    <TextBlock x:Name="ReceivedValue" Style="{StaticResource FactValue}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="CONTENT" Style="{StaticResource FactLabel}" />
                    <TextBlock x:Name="TypeValue" Style="{StaticResource FactValue}" />
                </StackPanel>
            </Grid>

            <!-- What PdaNet can and cannot see for this line -->
            <Border x:Name="NoteBox" CornerRadius="10" BorderThickness="1" Padding="13,11" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoteIcon" FontFamily="{StaticResource F.Icon}" FontSize="15" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="NoteTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                        <TextBlock x:Name="NoteBody" Style="{StaticResource T.Small}" Margin="0,3,0,0" LineHeight="17" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Request and answer, side by side -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SENT BY THE APP" Style="{StaticResource FactLabel}" Margin="2,0,0,6" />
                    <Border Style="{StaticResource HeadBox}" Height="136">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,9,6,9" Focusable="False">
                            <TextBlock x:Name="RequestText" Style="{StaticResource HeadText}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ANSWER FROM THE WEBSITE" Style="{StaticResource FactLabel}" Margin="2,0,0,6" />
                    <Border Style="{StaticResource HeadBox}" Height="136">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,9,6,9" Focusable="False">
                            <TextBlock x:Name="ResponseText" Style="{StaticResource HeadText}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Less of this: block the app or the site, no admin needed -->
            <Border CornerRadius="10" Background="{StaticResource B.Bg2}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                    Padding="13,10" Margin="0,16,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BlockSiteBtn" Style="{StaticResource Btn.Danger}" Tag="&#xE733;" Padding="12,6" Click="OnBlockSite" />
                        <Button x:Name="BlockAppBtn" Style="{StaticResource Btn.Danger}" Tag="&#xE733;" Padding="12,6" Margin="8,0,0,0"
                                Click="OnBlockApp" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Want to save data?" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                        <TextBlock x:Name="BlockHint" Style="{StaticResource T.Small}" Margin="0,2,0,0"
                                   Text="Block the website or the app here, remove a block any time from Blocked on the Apps page" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,20,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Secondary}" Tag="&#xE8C8;" Content="Copy details" Click="OnCopy"
                            ToolTip="Copy all details as text" />
                    <Button x:Name="CloseBtn" Style="{StaticResource Btn.Primary}" Content="Close" Margin="8,0,0,0" Click="OnClose" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource F.Icon}" FontSize="12" Foreground="{StaticResource B.Text3}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Cookies and passwords are hidden, nothing leaves this PC" Style="{StaticResource T.Small}"
                               Margin="8,0,12,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
