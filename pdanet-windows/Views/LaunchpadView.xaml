<UserControl x:Class="PdaNetPortable.Views.LaunchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PdaNetPortable.Views">
    <UserControl.Resources>
        <!-- A web app tile: icon, name and website, glows on hover and shows an open arrow -->
        <Style x:Key="AppTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Neon}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="118" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="14" Background="{StaticResource B.Accent}" Opacity="0" Margin="10">
                                <Border.Effect>
                                    <BlurEffect Radius="26" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}"
                                    BorderThickness="1" Padding="16,14">
                                <Grid>
                                    <ContentPresenter />
                                    <TextBlock x:Name="Arrow" Text="&#xE8A7;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                               Foreground="{StaticResource B.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,2,0,0" Opacity="0" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.AccentLine}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Bg2}" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0.09" />
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Bg1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A recent website: icon, title, website and when -->
        <Style x:Key="RecentRow" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Neon}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuLine" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource B.Line2}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Orbit" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{StaticResource B.AccentLine}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="1 5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="28,22,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ Title ============================ -->
            <DockPanel>
                <Border x:Name="RoutePill" DockPanel.Dock="Right" CornerRadius="14" Padding="12,5,14,5" BorderThickness="1"
                        VerticalAlignment="Center" Background="{StaticResource B.Bg2}" BorderBrush="{StaticResource B.Line2}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RouteDot" Width="7" Height="7" Fill="{StaticResource B.Text3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RouteText" Text="PdaNet offline" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Launchpad" Style="{StaticResource T.H1}" />
                    <TextBlock Text="Apps running right inside PdaNet: the PdaNet browser and screen share"
                               Style="{StaticResource T.Body}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- ======================= The PdaNet browser ======================= -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0" ClipToBounds="True">
                <Grid>
                    <Border CornerRadius="13" Background="{StaticResource B.AccentWash}" IsHitTestVisible="False" />
                    <Rectangle IsHitTestVisible="False" RadiusX="13" RadiusY="13">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.9,0.35" GradientOrigin="0.9,0.35" RadiusX="0.45" RadiusY="0.9">
                                <GradientStop Color="#1A2BF5A8" Offset="0" />
                                <GradientStop Color="#002BF5A8" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Orbit rings around the bottom right corner, two satellite dots turn while the page is on screen.
                         A zero size canvas keeps the rings out of the layout, the card clips the rest -->
                    <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Grid Width="300" Height="300" Canvas.Left="-140" Canvas.Top="-170" Opacity="0.9">
                            <Ellipse Style="{StaticResource Orbit}" Width="300" Height="300" Opacity="0.45" />
                            <Ellipse Style="{StaticResource Orbit}" Width="210" Height="210" Opacity="0.7" />
                            <Ellipse Style="{StaticResource Orbit}" Width="120" Height="120" StrokeDashArray="{x:Null}" Stroke="{StaticResource B.Line2}" />
                            <Grid Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="SatelliteTurn" Angle="-38" />
                                </Grid.RenderTransform>
                                <Ellipse Width="9" Height="9" Fill="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Top"
                                         Margin="0,41,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF2BF5A8" BlurRadius="14" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource B.Cyan}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="-3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF46D7F8" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Canvas>

                    <Grid Margin="26,24,26,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Globe orb with a ring that breathes while the browser is open -->
                        <Grid Width="72" Height="72" VerticalAlignment="Top">
                            <Ellipse x:Name="OrbRing" Stroke="{StaticResource B.Accent}" StrokeThickness="1.2" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="OrbScale" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource B.AccentSoft}"
                                    BorderBrush="{StaticResource B.AccentLine}" BorderThickness="1">
                                <TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="30" Foreground="{StaticResource B.Accent}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="20,4,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PdaNet Browser" Style="{StaticResource T.H2}" FontSize="21" FontFamily="{StaticResource F.Display}" />
                                <Border x:Name="StateBadge" Style="{StaticResource Badge}" Margin="12,2,0,0">
                                    <TextBlock x:Name="StateText" Text="READY" Style="{StaticResource T.Badge}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="HeroBody" Style="{StaticResource T.Body}" Margin="0,7,0,0" MaxWidth="540" HorizontalAlignment="Left"
                                       Text="Browse the web in a separate window with tabs, your web apps one click away, and sign ins kept apart from Edge and Chrome" />
                        </StackPanel>

                        <Button x:Name="OpenBtn" Grid.Column="2" Style="{StaticResource Btn.Primary}" Tag="&#xE8A7;" Content="Open browser"
                                Padding="18,10" VerticalAlignment="Top" Margin="0,4,0,0" Click="OnOpenBrowser"
                                ToolTip="Open the PdaNet browser" />

                        <!-- Type and go -->
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="20,20,0,0" MaxWidth="720" HorizontalAlignment="Stretch">
                            <!-- No top/bottom padding: the Segoe UI Variable line box is tall, padding here would
                                 squeeze it and clip the text. The text centers in the full height instead -->
                            <TextBox x:Name="GoBox" Style="{StaticResource Input.Search}" Tag="Search the web or type a web address"
                                     Height="44" FontSize="14" Padding="36,0,86,0" KeyDown="OnGoKey"
                                     AutomationProperties.Name="Search the web or type a web address" />
                            <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False">
                                <TextBlock Text="Enter" Style="{StaticResource T.Eyebrow}" FontSize="10.5" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="22,12,0,0">
                            <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource B.Text3}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveText" Style="{StaticResource T.Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="&#x2502;" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Line2}" Margin="12,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineText" Style="{StaticResource T.Small}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AgentSep" Text="&#x2502;" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Line2}" Margin="12,0"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="AgentText" Style="{StaticResource T.Small}" VerticalAlignment="Center" Visibility="Collapsed"
                                       Cursor="Hand" MouseLeftButtonUp="OnAgentText" ToolTip="AI agents, in Settings" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =========================== Screen share =========================== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" ClipToBounds="True">
                <Grid>
                    <Rectangle IsHitTestVisible="False" RadiusX="13" RadiusY="13">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.08,0.1" GradientOrigin="0.08,0.1" RadiusX="0.5" RadiusY="0.9">
                                <GradientStop Color="#1446D7F8" Offset="0" />
                                <GradientStop Color="#0046D7F8" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid Margin="26,22,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="56" Height="56" VerticalAlignment="Top">
                                <Ellipse x:Name="ShareRing" Stroke="{StaticResource B.Cyan}" StrokeThickness="1.2" Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="ShareRingScale" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Border Width="50" Height="50" CornerRadius="16" Background="{StaticResource B.CyanSoft}"
                                        BorderBrush="#5546D7F8" BorderThickness="1">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource T.Icon}" FontSize="23" Foreground="{StaticResource B.Cyan}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Screen share" Style="{StaticResource T.H2}" FontSize="21" FontFamily="{StaticResource F.Display}" />
                                    <Border x:Name="ShareBadge" Style="{StaticResource Badge}" Margin="12,2,0,0">
                                        <TextBlock x:Name="ShareBadgeText" Text="READY" Style="{StaticResource T.Badge}" />
                                    </Border>
                                    <v:InfoTip Margin="10,2,0,0" Heading="Screen share"
                                               Body="See and use another PC, or let someone see and use this one. The person who shares gets a code, the other person types it. The picture and the mouse and keyboard go straight between the two PCs, encrypted end to end, nothing to install and no account"
                                               Tip="The code works once, unless easy access is on. Only the PC that types it can connect, and only while you share" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Idle: share or connect -->
                        <Grid x:Name="ShareIdle" Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="12" Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                    Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="SHARE THIS SCREEN" Style="{StaticResource T.Eyebrow}" />
                                    <Button x:Name="ShareBtn" Style="{StaticResource Btn.Primary}" Tag="&#xE72D;" Content="Share my screen"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="18,10" Click="OnShare" />
                                    <!-- Easy access waits: its code, which stays the same -->
                                    <StackPanel x:Name="EasyPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EasyCodeText" Text="··· ··· ····" FontFamily="{StaticResource F.Mono}" FontSize="26"
                                                       FontWeight="SemiBold" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource Btn.Ghost}" Tag="&#xE8C8;" Content="Copy" Margin="14,0,0,0" Padding="10,5"
                                                    VerticalAlignment="Center" Click="OnCopyCode" ToolTip="Copy the code, to keep it or send it" />
                                            <Button Style="{StaticResource Btn.Ghost}" Tag="&#xE71A;" Content="Stop" Margin="6,0,0,0" Padding="10,5"
                                                    VerticalAlignment="Center" Click="OnStop" ToolTip="Stop sharing until PdaNet starts again" />
                                        </StackPanel>
                                        <TextBlock x:Name="EasyWaitText" Style="{StaticResource T.Small}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="EasyNotice" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Amber}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DockPanel Margin="0,16,0,0">
                                        <ToggleButton x:Name="AllowControl" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      Click="OnAllowControl" AutomationProperties.Name="Let them use my mouse and keyboard" />
                                        <TextBlock Text="Let them use my mouse and keyboard" Style="{StaticResource T.Small}"
                                                   Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <ToggleButton x:Name="EasyAccess" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      Checked="OnEasyAccess" Unchecked="OnEasyAccess"
                                                      AutomationProperties.Name="Easy access, share whenever PdaNet runs" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Easy access, share whenever PdaNet runs" Style="{StaticResource T.Small}"
                                                       Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                            <v:InfoTip Margin="8,0,0,0" Heading="Easy access"
                                                       Body="PdaNet shares this screen each time it starts, and again after each session, with a code that stays the same. From another PC you connect with that code, nobody needs to be here. With Start with Windows in Settings, PdaNet starts when you sign in, so after a restart this PC is reachable once someone signs in"
                                                       Tip="Anyone with the code can see this screen. Easy access cannot show or use the Windows sign-in, lock or UAC screens, and the mouse and keyboard do not reach apps that run as administrator. After wrong codes it waits before it takes more tries. Turning it off forgets the code" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="12" Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line}"
                                    BorderThickness="1" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="CONNECT TO A SCREEN" Style="{StaticResource T.Eyebrow}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CodeBox" FontFamily="{StaticResource F.Mono}" FontSize="18" Height="42"
                                                 Padding="14,0" VerticalContentAlignment="Center" MaxLength="14" Tag="000 000 0000"
                                                 PreviewTextInput="OnCodeInput" TextChanged="OnCodeChanged" KeyDown="OnCodeKey"
                                                 DataObject.Pasting="OnCodePaste" AutomationProperties.Name="Code from the other PC" />
                                        <Button x:Name="JoinBtn" Grid.Column="1" Style="{StaticResource Btn.Secondary}" Tag="&#xE8A7;"
                                                Content="Connect" Margin="10,0,0,0" Padding="16,9" Click="OnJoin"
                                                AutomationProperties.Name="Connect to the other PC" />
                                    </Grid>
                                    <TextBlock x:Name="JoinHint" Style="{StaticResource T.Small}" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Sharing: the code to read out -->
                        <Grid x:Name="ShareWaiting" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                            <Border CornerRadius="12" Background="{StaticResource B.Bg1}" BorderBrush="#4446D7F8" BorderThickness="1"
                                    Padding="22,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="YOUR CODE" Style="{StaticResource T.Eyebrow}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="CodeText" Text="··· ··· ····" FontFamily="{StaticResource F.Mono}" FontSize="38"
                                                       FontWeight="SemiBold" Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                            <Button x:Name="CopyCodeBtn" Style="{StaticResource Btn.Ghost}" Tag="&#xE8C8;" Content="Copy"
                                                    Margin="16,6,0,0" Padding="12,6" VerticalAlignment="Center" Click="OnCopyCode"
                                                    ToolTip="Copy the code to send it in a message" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Grid Width="13" Height="13" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Path x:Name="WaitSpinner" Stroke="{StaticResource B.Cyan}" StrokeThickness="2" StrokeStartLineCap="Round"
                                                      Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="WaitSpin" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                            <TextBlock x:Name="WaitText" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text2}"
                                                       VerticalAlignment="Center" Text="Getting ready" />
                                        </StackPanel>
                                        <TextBlock x:Name="WaitNotice" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Amber}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <TextBlock Style="{StaticResource T.Small}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Read the code to the other person, they type it under Connect to a screen. The code works once" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Tag="&#xE71A;" Content="Stop"
                                            VerticalAlignment="Top" Click="OnStop" ToolTip="Stop sharing, the code stops working" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- A session: connecting or live -->
                        <Grid x:Name="ShareActive" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                            <Border CornerRadius="12" Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                    Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ShareLiveDot" Width="10" Height="10" Fill="{StaticResource B.Accent}" VerticalAlignment="Top"
                                             Margin="0,7,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ActiveTitle" Style="{StaticResource T.RowTitle}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ActiveDetail" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text2}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ActiveStats" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel x:Name="HostControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Control" Style="{StaticResource T.Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ToggleButton x:Name="ActiveControl" Style="{StaticResource Switch}" Click="OnAllowControl"
                                                          ToolTip="Let them use your mouse and keyboard, turn it off to let them only see"
                                                          AutomationProperties.Name="Let them use my mouse and keyboard" />
                                        </StackPanel>
                                        <Button x:Name="ShowWindowBtn" Style="{StaticResource Btn.Secondary}" Tag="&#xE8A7;" Content="Show"
                                                Margin="0,0,8,0" Click="OnShowRemote" ToolTip="Bring the window with the other PC's screen forward" />
                                        <Button x:Name="EndBtn" Style="{StaticResource Btn.Danger}" Tag="&#xE71A;" Content="Stop sharing" Click="OnStop" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- How the session travels -->
                        <DockPanel Grid.Row="2" Margin="2,16,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CONNECTION" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Seg.Host}" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RouteDirect" Style="{StaticResource Seg}" GroupName="ShareRoute" Content="Direct"
                                                     Click="OnRoute" ToolTip="The two PCs reach each other the shortest way, straight across your network when they share one" />
                                        <RadioButton x:Name="RoutePhone" Style="{StaticResource Seg}" GroupName="ShareRoute" Content="Through your phone"
                                                     Click="OnRoute" ToolTip="The screen goes through the phone PdaNet is connected to, and its VPN when the phone runs one" />
                                    </StackPanel>
                                </Border>
                                <v:InfoTip Margin="10,0,0,0" Heading="Connection"
                                           Body="Direct links the two PCs the shortest way, on the same network straight across it, else over the internet. Through your phone sends the screen through the phone PdaNet is connected to, in every mode, Phone VPN included, so it takes the phone's network and VPN"
                                           Tip="Through your phone counts against your mobile data. A still screen sends almost nothing, video and scrolling send the most" />
                            </StackPanel>
                            <TextBlock x:Name="ShareRouteText" Style="{StaticResource T.Small}" Margin="14,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <!-- The last sessions, newest first, one for each PC -->
                        <StackPanel x:Name="RecentShares" Grid.Row="3" Margin="0,18,0,0" Visibility="Collapsed">
                            <DockPanel Margin="2,0,0,8" MinHeight="31">
                                <Button x:Name="ClearSharesBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Tag="&#xE74D;" Content="Clear"
                                        Padding="10,5" Click="OnClearShares" ToolTip="Clear the list of recent sessions, and the codes kept with it" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="RECENT SESSIONS" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" />
                                    <v:InfoTip x:Name="RecentSharesTip" Margin="8,0,0,0" Heading="Recent sessions"
                                               Tip="The codes are kept encrypted with Windows, for your Windows user only. Clear forgets them" />
                                </StackPanel>
                            </DockPanel>
                            <Border CornerRadius="12" Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                                    Padding="6">
                                <ItemsControl x:Name="ShareList" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RecentRow}" Click="OnShareAgain" ToolTip="{Binding Tip}"
                                                    AutomationProperties.Name="{Binding Spoken}" ContextMenuOpening="OnShareMenu">
                                                <Button.ContextMenu>
                                                    <ContextMenu />
                                                </Button.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                        <Border CornerRadius="8" Background="{StaticResource B.CyanSoft}" BorderBrush="#5546D7F8" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" FontSize="14"
                                                                   Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Center" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Small}" FontSize="11" Margin="0,2,0,0"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource T.Mono}" FontSize="10.5"
                                                                   Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                                        <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Accent}"
                                                                   Margin="10,0,2,0" Visibility="{Binding ConnectVisibility}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =================== Web apps and recent websites =================== -->
            <Grid Grid.Row="3" Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel Margin="2,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Tag="&#xE710;" Content="Add web app"
                                Padding="12,6" Click="OnAddWebApp" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="WEB APPS" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" />
                            <v:InfoTip Margin="8,0,0,0" Heading="Web apps"
                                       Body="Websites you use every day, pinned here and on every new tab in the browser. Each web app opens in the PdaNet browser in one click, in the tab where the web app is already open"
                                       Tip="In the browser, press the star in the address bar to pin the website you are on" />
                            <TextBlock x:Name="AppCount" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl x:Name="AppTiles" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AppTile}" Click="OnOpenWebApp" ToolTip="{Binding Tip}"
                                        AutomationProperties.Name="{Binding Name}" ContextMenuOpening="OnWebAppMenu">
                                    <Button.ContextMenu>
                                        <ContextMenu />
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Border CornerRadius="11" Background="{StaticResource B.Bg3}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" />
                                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding IconVisibility}" />
                                            <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource F.Display}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding MonogramVisibility}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                                   Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No web apps yet -->
                    <Grid x:Name="AppsEmpty" Visibility="Collapsed" Margin="0,0,12,0">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource B.Line2}" StrokeThickness="1.2" StrokeDashArray="3 4"
                                   IsHitTestVisible="False" />
                        <Grid Margin="22,20,22,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top">
                                <TextBlock Text="&#xE74C;" Style="{StaticResource T.Icon}" FontSize="17" Foreground="{StaticResource B.Accent}"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="Pin the websites you use every day" Style="{StaticResource T.RowTitle}" FontSize="14" />
                                <TextBlock Style="{StaticResource T.Body}" Margin="0,5,0,0"
                                           Text="Each web app opens in the PdaNet browser in one click, from here and from every new tab" />
                                <TextBlock Style="{StaticResource T.Small}" Margin="0,8,0,0"
                                           Text="In the browser, press the star in the address bar to pin the website you are on" />
                                <Button Style="{StaticResource Btn.Primary}" Tag="&#xE710;" Content="Add web app" HorizontalAlignment="Left"
                                        Margin="0,16,0,0" Click="OnAddWebApp" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel Margin="2,0,0,12" MinHeight="31">
                        <Button x:Name="ClearRecentBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Tag="&#xE74D;" Content="Clear"
                                Padding="10,5" Click="OnClearRecent" ToolTip="Clear the list of recent websites" />
                        <TextBlock Text="RECENT WEBSITES" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="6">
                        <Grid>
                            <ItemsControl x:Name="RecentList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RecentRow}" Click="OnOpenRecent" ToolTip="{Binding Tip}"
                                                AutomationProperties.Name="{Binding Name}" ContextMenuOpening="OnRecentMenu">
                                            <Button.ContextMenu>
                                                <ContextMenu />
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                    <Border CornerRadius="8" Background="{StaticResource B.Bg3}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" />
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding IconVisibility}" />
                                                    <TextBlock Text="{Binding Monogram}" FontFamily="{StaticResource F.Display}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding MonogramVisibility}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Mono}" FontSize="10.5"
                                                               Foreground="{StaticResource B.Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource T.Mono}" FontSize="10.5"
                                                           Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="RecentEmpty" Margin="14,22,14,24" Visibility="Collapsed">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Line2}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Websites you open in the PdaNet browser show up here" Style="{StaticResource T.Small}"
                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
