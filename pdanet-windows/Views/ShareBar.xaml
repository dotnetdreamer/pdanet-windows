<Window x:Class="PdaNetPortable.Views.ShareBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdaNet screen share" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="{StaticResource B.Bg1}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource F.Ui}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="#6646D7F8" BorderThickness="1" Padding="12,7,8,7" Cursor="SizeAll"
            MouseLeftButtonDown="OnDrag" ToolTip="Drag to move">
        <StackPanel Orientation="Horizontal">
            <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Ellipse x:Name="Pulse" Fill="{StaticResource B.Red}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Red}" />
            </Grid>
            <TextBlock x:Name="Text" Margin="10,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxWidth="300" />
            <Border Width="1" Height="18" Background="{StaticResource B.Line2}" Margin="0,0,12,0" />
            <TextBlock Text="Control" Style="{StaticResource T.Small}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ToggleButton x:Name="Control" Style="{StaticResource Switch}" Click="OnControl" Cursor="Hand"
                          ToolTip="Let them use your mouse and keyboard, turn it off to let them only see"
                          AutomationProperties.Name="Let them use my mouse and keyboard" />
            <Button Style="{StaticResource Btn.Danger}" Tag="&#xE71A;" Content="Stop" Padding="10,4" Margin="12,0,0,0"
                    Click="OnStop" Cursor="Hand" ToolTip="Stop sharing your screen" />
        </StackPanel>
    </Border>
</Window>
