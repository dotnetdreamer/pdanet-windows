<UserControl x:Class="PdaNetPortable.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Btn.Secondary}" Tag="&#xE72C;" Content="Refresh" Click="OnRefresh" />
                <Button x:Name="ClearBtn" Style="{StaticResource Btn.Danger}" Tag="&#xE74D;" Content="Clear history"
                        Margin="8,0,0,0" Click="OnClear" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="History" Style="{StaticResource T.H1}" />
                <TextBlock Text="Every session on this PC, newest first" Style="{StaticResource T.Body}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="SESSIONS" Style="{StaticResource T.Eyebrow}" />
                    <TextBlock x:Name="TotSessions" Text="0" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="TIME ONLINE" Style="{StaticResource T.Eyebrow}" />
                    <TextBlock x:Name="TotTime" Text="00:00:00" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Eyebrow}"><Run Text="&#x2193; " Foreground="{StaticResource B.Accent}" /><Run Text="DOWNLOADED" /></TextBlock>
                    <TextBlock x:Name="TotDown" Text="0 B" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource T.Eyebrow}"><Run Text="&#x2191; " Foreground="{StaticResource B.Cyan}" /><Run Text="UPLOADED" /></TextBlock>
                    <TextBlock x:Name="TotUp" Text="0 B" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="20,13">
                            <Grid TextElement.FontFamily="{StaticResource F.Mono}" TextElement.FontSize="10.5"
                                  TextElement.Foreground="{StaticResource B.Text3}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="WHEN" Margin="26,0,0,0" />
                                <TextBlock Grid.Column="1" Text="DURATION" />
                                <TextBlock Grid.Column="2" Text="DOWNLOADED" />
                                <TextBlock Grid.Column="3" Text="UPLOADED" />
                                <TextBlock Grid.Column="4" Text="CONNECTION" />
                                <TextBlock Grid.Column="5" Text="AVG PING" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="Sessions" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBd" Padding="20,12" Background="Transparent"
                                            BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE823;" Style="{StaticResource T.Icon}" FontSize="13"
                                                           Foreground="{StaticResource B.Text3}" />
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource B.Text}" FontSize="13"
                                                           Margin="13,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource B.Text}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Down}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Up}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Connection}" Style="{StaticResource Cell}"
                                                       FontFamily="{StaticResource F.Ui}" FontSize="13" />
                                            <TextBlock Grid.Column="5" Text="{Binding Ping}" Style="{StaticResource Cell}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{StaticResource B.Hover}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <Ellipse Stroke="{StaticResource B.Line2}" StrokeThickness="1" StrokeDashArray="2 3" />
                        <TextBlock Text="&#xE81C;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Text3}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="No sessions yet" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Your sessions show up here after you connect" Style="{StaticResource T.Small}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
