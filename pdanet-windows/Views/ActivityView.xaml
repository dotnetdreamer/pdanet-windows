<UserControl x:Class="PdaNetPortable.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Activity" Style="{StaticResource T.H1}" />
            <TextBlock Text="A live record of everything the app does, handy when something does not work"
                       Style="{StaticResource T.Body}" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Secondary}" Tag="&#xE8C8;" Content="Copy" Click="OnCopy"
                        ToolTip="Copy every line shown below" />
                <Button Style="{StaticResource Btn.Secondary}" Tag="&#xEDE1;" Content="Save to file" Margin="8,0,0,0" Click="OnExport"
                        ToolTip="Save the activity as a text file you can share" />
                <Button Style="{StaticResource Btn.Ghost}" Tag="&#xE74D;" Content="Clear" Margin="8,0,0,0" Click="OnClear" />
            </StackPanel>
            <TextBox x:Name="Search" Style="{StaticResource Input.Search}" Tag="Search activity" Width="250"
                     TextChanged="OnFilterChanged" AutomationProperties.Name="Search activity" />
            <Border Style="{StaticResource Seg.Host}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource Seg}" GroupName="LogFilter" Content="Everything"
                                 IsChecked="True" Checked="OnFilterChanged" />
                    <RadioButton x:Name="FilterProblems" Style="{StaticResource Seg}" GroupName="LogFilter" Content="Problems only"
                                 Checked="OnFilterChanged" />
                </StackPanel>
            </Border>
            <ToggleButton x:Name="Follow" Style="{StaticResource Switch}" IsChecked="True" Margin="18,0,0,0"
                          ToolTip="Jump to new lines as they arrive" AutomationProperties.Name="Follow new lines" />
            <TextBlock Text="Follow" Style="{StaticResource T.Small}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </DockPanel>

        <Border Grid.Row="2" CornerRadius="14" Background="{StaticResource B.Terminal}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource B.Red}" Opacity="0.8" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource B.Amber}" Opacity="0.8" Margin="7,0,0,0" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource B.Accent}" Opacity="0.8" Margin="7,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="pdanet@windows: ~/activity" Style="{StaticResource T.Mono}" FontSize="11"
                                   Foreground="{StaticResource B.Text3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.Text3}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,8"
                         ItemContainerStyle="{StaticResource Terminal.Item}" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Activity lines">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource F.Mono}" FontSize="12"
                                           Foreground="{StaticResource B.Text3}" />
                                <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="{StaticResource F.Mono}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{Binding TagBrush}" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource F.Mono}" FontSize="12"
                                           Foreground="{Binding TextBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE756;" Style="{StaticResource T.Icon}" FontSize="30" Foreground="{StaticResource B.Line2}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="Nothing here yet" Style="{StaticResource T.Small}" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="16,9">
                    <TextBlock FontFamily="{StaticResource F.Mono}" FontSize="12"><Run Text="pdanet" Foreground="{StaticResource B.Accent}" /><Run Text=" &#x203A; " Foreground="{StaticResource B.Text3}" /><Run x:Name="PromptText" Text="watching for new activity" Foreground="{StaticResource B.Text3}" /><Run Text=" &#x258C;"><Run.Foreground><SolidColorBrush x:Name="PromptCaret" Color="#FF2BF5A8" /></Run.Foreground></Run></TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
