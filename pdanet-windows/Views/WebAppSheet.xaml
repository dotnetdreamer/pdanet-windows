<UserControl x:Class="PdaNetPortable.Views.WebAppSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500">
    <Border Background="{StaticResource B.Bg1}" BorderBrush="{StaticResource B.Line2}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,24,26,22">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                        <Border Style="{StaticResource IconTile}" />
                        <Image x:Name="SiteIcon" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="SiteGlyph" Text="&#xE74C;" Style="{StaticResource T.Icon}" FontSize="18"
                                   Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Heading" Text="Add a web app" Style="{StaticResource T.H2}" FontSize="17" />
                        <TextBlock Text="Web apps open in the PdaNet browser in one click, from the Launchpad and from every new tab"
                                   Style="{StaticResource T.Small}" Margin="0,2,0,0" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancel" ToolTip="Close" AutomationProperties.Name="Close" />
            </Grid>

            <TextBlock Text="Web address" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text2}" Margin="0,22,0,6" />
            <TextBox x:Name="AddressBox" Tag="For example outlook.office.com" TextChanged="OnAddressChanged"
                     AutomationProperties.Name="Web address" />

            <TextBlock Text="Name" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Text2}" Margin="0,14,0,6" />
            <TextBox x:Name="NameBox" Tag="Filled in from the web address" TextChanged="OnNameChanged" MaxLength="40"
                     AutomationProperties.Name="Name" />

            <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource F.Icon}" FontSize="12" Foreground="{StaticResource B.Red}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource T.Small}" Foreground="{StaticResource B.Red}" Margin="8,0,0,0" />
            </StackPanel>

            <DockPanel Margin="0,24,0,0">
                <Button x:Name="RemoveBtn" DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}" Tag="&#xE74D;" Content="Remove"
                        Click="OnRemove" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Ghost}" Content="Cancel" Click="OnCancel" />
                    <Button x:Name="SaveBtn" Style="{StaticResource Btn.Primary}" Content="Add web app" Margin="8,0,0,0"
                            IsDefault="True" Click="OnSave" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
