<UserControl x:Class="PdaNetPortable.Views.InfoTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" VerticalAlignment="Center">
    <TextBlock x:Name="Icon" Text="&#xE946;" FontFamily="{StaticResource F.Icon}" FontSize="14"
               Foreground="{StaticResource B.Text3}" Cursor="Help" VerticalAlignment="Center"
               ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="60000" ToolTipService.BetweenShowDelay="0">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource B.Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
</UserControl>
